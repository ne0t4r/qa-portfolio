<?xml version="1.0" encoding="ISO-8859-1"?>
<root text="main()" comment="" type="program" style="nice">
 <children>

<instruction text="&#34;VSTUP cisloUctu&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<while text="&#34;cisloUctu != -1&#34;" comment="" color="FFFFFF">
 <qWhile>

<instruction text="&#34;INPUT pociatocnyZostatok, vydavky, prijmy, limit&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<instruction text="&#34;novyZostatok = pociatocny zostatok + vydavky - prijmy&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<alternative text="&#34;novyZostatok &#62; limit&#34;" comment="" color="FFFFFF">
 <qTrue>

<instruction text="&#34;OUTPUT cisloUctu,limit, novyZostatok &#34;&#34;limit bol prekroceny''&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
 </qTrue>
 <qFalse>

 </qFalse>
</alternative>
<instruction text="&#34;INPUT cisloUctu&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
 </qWhile>
</while>
 </children>
</root>
