<?xml version="1.0" encoding="ISO-8859-1"?>
<root text="main()" comment="" type="program" style="nice">
 <children>

<instruction text="&#34;celkovaSpotreba  = 0&#34;,&#34;celkovaVzdialenost = 0&#34;,&#34;aktualnaSpotreba = 0&#34;,&#34;prejdenaVzdialenost = 0&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<instruction text="&#34;INPUT aktualnaSpotreba&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<while text="&#34;aktualnaSpotreba != -1&#34;" comment="" color="FFFFFF">
 <qWhile>

<instruction text="&#34;INPUT prejdenaVzdialenost&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<instruction text="&#34;priemernaSpotreba = (aktualnaSpotreba / prejdenaVzdialenost) *100&#34;,&#34;celkovaVzdialenost = celkovaVzdialenost + prejdenaVzdialenost&#34;,&#34;celkovaSpotreba = celkovaSpotreba + aktualnaSpotreba&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<instruction text="&#34;OUTPUT priemernaSpotreba&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<instruction text="&#34;INPUT aktualnaSpotreba&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
 </qWhile>
</while>
<alternative text="&#34;celkovaVzdialenost = 0&#34;" comment="" color="FFFFFF">
 <qTrue>

<instruction text="&#34;OUTPUT 0&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
 </qTrue>
 <qFalse>

<instruction text="&#34;dlhodobaPriemernaSpotreba = (celkovaSpotreba / celkovaVzdialenost) * 100&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
<instruction text="&#34;OUTPUT dlhodobaPriemernaSpotreba&#34;" comment="" color="FFFFFF" rotated="0"></instruction>
 </qFalse>
</alternative>
 </children>
</root>
