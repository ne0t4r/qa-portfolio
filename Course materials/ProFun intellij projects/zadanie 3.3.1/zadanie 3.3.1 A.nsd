<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-11" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="LUKE\lukas" created="2023-09-29" changedby="lukas" changed="2023-10-05" origin="Structorizer &#60; 3.23-12 (legacy NSD file)" text="&#34;main()&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT vyskaUveru, urokovaSadzba, obdobieViazanosti&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<while text="&#34;vyskaUveru !=  -1&#34;" comment="" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;poplatky = (vyskaUveru * urokovaSadzba * obdobieViazanosti) / 365&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;OUTPUT poplatky&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;INPUT vyskaUveru, urokovaSadzba, obdobieViazanosti&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qWhile>
		</while>
	</children>
</root>