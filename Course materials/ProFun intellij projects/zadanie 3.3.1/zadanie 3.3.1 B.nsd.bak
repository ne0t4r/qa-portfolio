<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-11" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="???" changedby="lukas" changed="2023-10-05" origin="Structorizer &#60; 3.23-12 (legacy NSD file)" text="&#34;main()&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;INPUT odpracovaneHodiny, hodinovaSadzba&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<while text="&#34;odpracovaneHodiny != -1&#34;" comment="" color="ffffff" disabled="0">
			<qWhile>
				<while text="&#34;odpracovaneHodiny &#60;= 40&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qWhile>
						<instruction text="&#34;tyzdennaMzda = (odpracovaneHodiny * hodinovaSadzba)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;OUTPUT tyzdennaMzda&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;INPUT odpracovaneHodiny, hodinovaSadzba&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qWhile>
				</while>
				<instruction text="&#34;nadcasy = (odpracovaneHodiny - 40) * 1.5&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;tyzdennaMzda2 = (odpracovaneHodiny * hodinovaSadzba) + nadcasy&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;OUTPUT tyzdennaMzda2 + nadcasy&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;INPUT odpracovaneHodiny, hodinovaSadzba&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qWhile>
		</while>
	</children>
</root>