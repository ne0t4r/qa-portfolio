	<children>
		<instruction text="&#34;INPUT parkHodiny1, parkHodiny2, parkHodiny3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<call text="&#34;poplatky1 = spocitajPoplatky(parkHodiny1)&#34;,&#34;poplatky2 = spocitajPoplatky(parkHodiny2)&#34;,&#34;poplatky3 = spocitajPoplatky(parkHodiny3)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" ismethoddecl="0"></call>
		<instruction text="&#34;sucetHodiny = parkHodiny1 + parkHodiny2 + parkHodiny3&#34;,&#34;sucetPoplatky =  poplatky1 + poplatky2 + poplatky3&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
