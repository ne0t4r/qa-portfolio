<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-11" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="lukas" created="2023-10-26" changedby="lukas" changed="2023-10-30" origin="Structorizer 3.32-11" text="&#34;spocitajPoplatky(hodinyA)&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;vysledok = 0&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
