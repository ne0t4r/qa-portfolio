<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-11" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" namespace="" author="lukas" created="2023-11-08" changedby="lukas" changed="2023-11-08" origin="Structorizer 3.32-11" text="&#34;main()&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;sucty[13]&#34;,&#34;ocakavaneHodnoty{0, 0, 1, 2, 3, 4, 5, 6, 5, 4, 3, 2, 1}&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;i = 0; i &#60; 36000; i++&#34;" comment="&#34;&#34;" counterVar="dummy_counter" startValue="i = 0; i &#60; 36000; i++" stepConst="1" style="FREETEXT" color="ffffff" disabled="0">
			<qFor>
				<instruction text="&#34;kocka1 = random&#34;,&#34;kocka2 = random&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;sucet = kocka1 + kocka2&#34;,&#34;sucty{sucet} ++&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<for text="&#34;i = 2; i &#60; = 12; i++&#34;" comment="&#34;&#34;" counterVar="dummy_counter" startValue="i = 2; i &#60; = 12; i++" stepConst="1" style="FREETEXT" color="ffffff" disabled="0">
			<qFor>
				<instruction text="&#34;ocakavane = ocakavaneHodnoty[i] * 100 / 36&#34;,&#34;skutocne = sucty[i] * 100 / 36000&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;OUTPUT ocakavane, skutocne&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
	</children>
</root>